---
config:
  htmlLabels: false
---
classDiagram
    direction LR

    class BaseModel {
        <<pydantic>>
    }

    class Database {
        +str path
        +connect() Connection
        +initialize()
    }

    class ProductInput {
        +str name
        +int price_cents
        +int stock
    }

    class CustomerInput {
        +str name
        +EmailStr email
        +Literal category
    }

    class ItemInput {
        +int product_id
        +int quantity
    }

    class OrderInput {
        +int customer_id
        +str address
        +str city
        +str postal_code
        +Literal shipping
        +list~ItemInput~ items
        +unique_products() OrderInput
    }

    class OrderStatus {
        <<enumeration>>
        PENDING
        CONFIRMED
        CANCELLED
    }

    class OrderService {
        +Database database
        +create(data) dict
        +update(order_id, data) dict
        +quote(data) dict
        +get(order_id) dict
        +list() list
        +confirm(order_id) dict
        +cancel(order_id) dict
        +delete(order_id)
        +notifications(order_id) list
        -_price(connection, data) tuple
        -_order_values(data, customer, totals) tuple$
        -_insert_items(connection, order_id, lines)$
        -_find_order(connection, order_id) Row$
        -_pending_order(connection, order_id, message) Row
        -_load(connection, order_id) dict
        -_set_status(connection, order_id, status)$
    }

    class HTTPException {
        <<FastAPI>>
    }

    BaseModel <|-- ProductInput
    BaseModel <|-- CustomerInput
    BaseModel <|-- ItemInput
    BaseModel <|-- OrderInput
    OrderInput "1" *-- "1..100" ItemInput : items
    OrderService --> "1" Database : database
    OrderService ..> OrderInput : create() / update() / quote()
    OrderService ..> OrderStatus : usa
    OrderService ..> HTTPException : lanza
